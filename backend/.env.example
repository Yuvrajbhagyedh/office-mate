# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth (employee ID + DOB) ---
AUTH_SECRET=office-mate-dev-secret-change-me
SEED_ADMIN_EMPLOYEE_ID=ADMIN001
SEED_ADMIN_DOB=1990-01-15
SEED_ADMIN_NAME=Office Admin
SEED_EMPLOYEE_ID=EMP1001
SEED_EMPLOYEE_DOB=1995-06-20
SEED_EMPLOYEE_NAME=Alex Employee

# --- LLM ---
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_ai_studio_key
LLM_MODEL=gemini-flash-latest

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Embeddings / reranking ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking / retrieval ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_N=5
MIN_RERANK_SCORE=-6.0
